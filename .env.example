# Application LinkedIn Developer « Quarkslab Data »
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Jetons OAuth 2.0 (remplis par `npm run auth`, renouvelés par `npm run refresh-token`)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=

# Compte publicitaire et page LinkedIn Quarkslab (résolus automatiquement si vides)
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ORG_ID=

# URL de redirection déclarée dans l'application LinkedIn
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback
LINKEDIN_API_VERSION=202509
